PORT=8790
HOST=127.0.0.1
DB_PATH=data/carebridge.sqlite
ALLOWED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090,http://localhost:8790,http://127.0.0.1:8790
# Configure only on the server. Never place credentials in EXPO_PUBLIC_*.
AI_GATEWAY_API_KEY=
# Select a model id from https://ai-gateway.vercel.sh/v1/models
AI_MODEL=

# Gemini direct API (server only). Fill key locally, never commit .env.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Google login. Comma-separated authorized WEB OAuth client IDs.
# Gemini API keys are not Google Sign-In credentials.
GOOGLE_CLIENT_IDS=
